{
  "name": "fleet-control-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MasiTrack API con Fastify y PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "uat:seed": "pnpm run build && node dist/scripts/uat-fixtures.js seed",
    "uat:cleanup": "pnpm run build && node dist/scripts/uat-fixtures.js cleanup",
    "uat:presence": "pnpm run build && node dist/scripts/uat-presence.js",
    "security:apply-rls": "pnpm run build && node dist/scripts/uat-fixtures.js rls",
    "db:check-location": "tsx scripts/check-driver-location.ts",
    "test": "tsx --test test/auth.test.ts test/bootstrap.test.ts test/tracking.test.ts test/administration.test.ts test/driver-order-eligibility.test.ts test/security.test.ts test/env.test.ts test/migration-roles.test.ts test/migration-app-views.test.ts",
    "test:security": "pnpm run build && node dist/scripts/check-security.js",
    "test:integration-admin": "tsx scripts/check-administration.ts",
    "test:management-queue": "tsx scripts/check-management-queue.ts",
    "test:management-queue-dry-run": "tsx scripts/check-management-queue.ts --apply-migration",
    "test:integration-critical": "pnpm run build && node dist/scripts/check-critical-operations.js",
    "test:fcm": "pnpm run build && node dist/scripts/check-fcm.js",
    "test:insights": "pnpm run build && node dist/scripts/check-insights.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
