NODE_ENV=development
PORT=3000
# BACKEND_HOST overrides HOST. Use 0.0.0.0 only for a controlled LAN UAT.
BACKEND_HOST=127.0.0.1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fleet_control_db
# Use the least-privileged application account in production.
DATABASE_USER=fleet_app
DATABASE_PASSWORD=replace-with-an-external-secret
# external requires verified TLS in production. render_private is only for a
# Render PostgreSQL internal hostname in the same Render region and disables TLS.
DATABASE_NETWORK=external
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=<PEM CA supplied by the provider, when required>

# Migration credentials are independent from the Fastify runtime account.
# MIGRATION_DATABASE_USER must be fleet_migrator and may assume fleet_owner.
MIGRATION_DATABASE_HOST=localhost
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_NAME=fleet_control_db
MIGRATION_DATABASE_USER=fleet_migrator
MIGRATION_DATABASE_PASSWORD=replace-with-an-external-secret
MIGRATION_DATABASE_SSL=false
MIGRATION_DATABASE_SSL_REJECT_UNAUTHORIZED=true
# MIGRATION_DATABASE_SSL_CA=<PEM CA supplied by the provider, when required>

API_LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Explicit reverse-proxy IPs/CIDRs only. Keep false when Fastify is not behind one.
TRUST_PROXY=false

BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
SESSION_TTL_HOURS=24

API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
LOGIN_USERNAME_LIMIT_MAX=5
LOGIN_USERNAME_WINDOW_MS=60000
LOGIN_IP_LIMIT_MAX=20
LOGIN_IP_WINDOW_MS=900000

# Optional server-only integrations. Never pass these through Flutter dart-defines.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
FIREBASE_HTTP_TIMEOUT_MS=10000
# TRACCAR_BASE_URL=https://traccar.internal/api/
# TRACCAR_AUTHORIZATION=Bearer replace-with-an-external-secret
TRACCAR_HTTP_TIMEOUT_MS=10000
